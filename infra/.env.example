# قمر الزمان — إعداد النشر على IP:3200 (بدون دومين / بدون certbot)
COMPOSE_PROJECT_NAME=qamar

# عنوان السيرفر العام (IP:port) — ليس دومين
DOMAIN=187.127.88.146:3200

POSTGRES_USER=qamar
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_DB=qamar

JWT_ACCESS_SECRET=change_me_long_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_long_random_refresh_secret_min_32_chars

ADMIN_EMAIL=admin@qamar.local
ADMIN_PASSWORD=ChangeMeStrongAdminPassword

CORS_ORIGIN=http://187.127.88.146:3200,http://187.127.88.146,http://localhost:3200

# HTTP فقط — لا HSTS بدون HTTPS
ENABLE_HSTS=0

MEDIA_PUBLIC_BASE_URL=http://187.127.88.146:3200/media

# 1 = أنشئ/حدّث حساب الأدمن فقط عند إقلاع الـ API
RUN_SEED=0
SEED_DEMO=0

MEDIA_MAX_FILE_SIZE_MB=15
MEDIA_MAX_ORIGINAL_WIDTH=2400
MEDIA_WEBP_QUALITY=90
MEDIA_JPEG_QUALITY=90
MEDIA_AVIF_QUALITY=62

THROTTLE_LIMIT=300
HOME_FEED_CACHE_TTL_SEC=90
DISK_WARN_PERCENT=85

# لا مفاتيح زحف/بوتات مشتركة مع التطبيق الأساسي
AMAZON_AUTO_CRAWL=0

OPENAI_MODEL=gpt-5.4-nano

AI_ASSISTANT_ENABLED=1
AI_PRIMARY_MODEL=gpt-5.6-terra
AI_FAST_MODEL=gpt-5.4-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOOL_ITERATIONS=4
AI_REQUEST_TIMEOUT_MS=45000
AI_ASSISTANT_THROTTLE_PER_MIN=15
AI_DAILY_USER_MESSAGE_CAP=120
AI_DEBUG=0
